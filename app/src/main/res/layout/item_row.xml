<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/rowAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar"
        android:backgroundTint="?attr/appAccentSoft"
        android:fontFamily="?attr/appFontSemibold"
        android:gravity="center"
        android:textColor="?attr/appAccentDark"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="?attr/appFontMedium"
            android:maxLines="1"
            android:textColor="?attr/appInk"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rowSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/appMuted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/appMuted"
        android:textSize="12sp" />
</LinearLayout>
